# Entorno a usar: carga .env.<TEST_ENV> y luego .env como respaldo.
# Valores previstos: local | prod. Por defecto: local.
TEST_ENV=local
BASE_URL=http://localhost/memorial/
E2E_USER=
E2E_PASS=
# Idioma con el que se autentica el setup (es | en). Por defecto: es.
E2E_LANG=es
# Workers en paralelo contra XAMPP. Por defecto: 1.
E2E_WORKERS=1
